# Public origin where the app is served, no trailing slash.
APP_ORIGIN=http://localhost:3000

# PostgreSQL connection string used by the app and migrations.
DATABASE_URL=postgres://p0ntus:change-me@127.0.0.1:5432/p0ntus

# 32+ random bytes. Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=replace-with-a-long-random-value

# 16+ random bytes. Used once by /setup. Generate with: openssl rand -hex 16
BOOTSTRAP_SECRET=replace-with-a-one-time-secret

# The profile that owns / and carries Aidan's verified content.
HOME_USERNAME=p0ntus

# Cloudflare Turnstile keys. The values below are Cloudflare's public test keys
# and must never be used in production.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Directory for administrator-uploaded avatars. Mount a volume here in Docker.
UPLOAD_DIR=./uploads

# Compose only: password for the bundled PostgreSQL service.
POSTGRES_PASSWORD=change-me
